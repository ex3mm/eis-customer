# HTTP API
EIS_PORT=8080
EIS_SERVER_PORT=8080
EIS_DOCS_ENABLED=true
EIS_AUTH_ENABLED=false
# EIS_AUTH_API_KEY=replace-with-a-long-random-secret

# Внешние запросы: одна исходная попытка + максимум один повтор
EIS_REQUEST_TIMEOUT=20
EIS_MAX_RETRIES=1
EIS_RETRY_DELAY=500
EIS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124 Safari/537.36

# Прокси через запятую; пусто означает прямое подключение
# EIS_PROXIES=http://proxy:3128,http://user:password@proxy2:8080,socks5://127.0.0.1:1080

# TLS: безопасный вариант — каталог PEM/CRT сертификатов Минцифры
# EIS_TLS_CA_CERTS_DIR=/app/cert
# Временный небезопасный fallback (не включать одновременно без необходимости)
# EIS_INSECURE_SKIP_TLS_VERIFY=true

# Кеш успешных полных ответов
EIS_CACHE_ENABLED=false
EIS_CACHE_TTL=1h

# HTML-фикстуры: off — выключено, write — сохранять live-ответы, read — offline
EIS_FIXTURES_MODE=off
EIS_FIXTURES_DIR=/app/fixtures

# URL источников
EIS_44_BASE_URL=https://zakupki.gov.ru/epz/organization/search/results.html
EIS_223_BASE_URL=https://zakupki.gov.ru/epz/customer223/search/results.html

# Статические query-параметры поиска 44-ФЗ
EIS_44_PARAM_MORPHOLOGY=on
EIS_44_PARAM_FZ94=on
EIS_44_PARAM_FZ223=on
EIS_44_PARAM_F=on
EIS_44_PARAM_S=on
EIS_44_PARAM_M=on
EIS_44_PARAM_NOT_FSM=on
EIS_44_PARAM_REGISTERED94=on
EIS_44_PARAM_NOT_REGISTERED=on
EIS_44_PARAM_ORGANIZATION_ROLE={}
EIS_44_PARAM_ORGANIZATION_TYPE={}
EIS_44_PARAM_LEGAL_ENTITY_KIND={}
EIS_44_PARAM_SORT_BY=NAME
EIS_44_PARAM_PAGE_NUMBER=1
EIS_44_PARAM_SORT_DIRECTION=false
EIS_44_PARAM_RECORDS_PER_PAGE=_10
EIS_44_PARAM_SHOW_LOTS_INFO=false

# Статические query-параметры поиска 223-ФЗ.
# Передается только status=0 (Зарегистрирован); статус Исключен не включен.
EIS_223_PARAM_MORPHOLOGY=on
EIS_223_PARAM_SEARCH_FILTER=Дате размещения
EIS_223_PARAM_PAGE_NUMBER=1
EIS_223_PARAM_SORT_DIRECTION=false
EIS_223_PARAM_RECORDS_PER_PAGE=_10
EIS_223_PARAM_SHOW_LOTS_INFO=false
EIS_223_PARAM_SORT_BY=NAME
EIS_223_PARAM_REGISTERED_STATUS_ENABLED=on
EIS_223_PARAM_REGISTERED_STATUS=0
EIS_223_PARAM_ORGANIZATION_ROLE={}
